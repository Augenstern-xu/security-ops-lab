#!/bin/sh
# 三道闸第 2 道：提交前扫描敏感信息
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

pattern='192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}|\.10[0-4]\b|\.120\b|hadoop10[0-4]|xuyu|loguser[0-9]*|BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY|(password|passwd|secret|token)[[:space:]]*[:=]'

bad=0
for f in $files; do
  case "$f" in
    hooks/pre-commit) continue ;;
    *.png|*.jpg|*.jpeg|*.gif|*.zip|*.tar|*.tar.gz|*.tgz|*.7z) continue ;;
  esac
  if grep -nEI "$pattern" "$f" >/dev/null 2>&1; then
    echo "❌ 发现敏感信息：$f"
    grep -nEI "$pattern" "$f" || true
    bad=1
  fi
done

if [ "$bad" -eq 1 ]; then
  echo ""
  echo "提交已阻止：替换成占位符，重新 git add 后再提交。"
  exit 1
fi
exit 0
